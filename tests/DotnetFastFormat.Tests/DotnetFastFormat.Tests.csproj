<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Test tiers (ADR 0005). Plain `dotnet test` runs the fast tier; the Slow tier (network, large inputs)
         runs in the scheduled workflow. Override with `dotnet test -p:TestTier=slow` or `-p:TestTier=all`. -->
    <TestTier Condition="'$(TestTier)' == ''">fast</TestTier>
    <TestingPlatformCommandLineArguments Condition="'$(TestTier)' == 'fast'">--filter-not-trait "Category=Slow"</TestingPlatformCommandLineArguments>
    <TestingPlatformCommandLineArguments Condition="'$(TestTier)' == 'slow'">--filter-trait "Category=Slow"</TestingPlatformCommandLineArguments>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="golden/**" />
    <None Include="golden/**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Verify.XunitV3" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DotnetFastFormat.Core/DotnetFastFormat.Core.csproj" />
    <ProjectReference Include="../../src/DotnetFastFormat.Cli/DotnetFastFormat.Cli.csproj" />
  </ItemGroup>
</Project>
