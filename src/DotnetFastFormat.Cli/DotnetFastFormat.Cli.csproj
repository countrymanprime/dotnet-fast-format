<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>dotnet-fast-format</AssemblyName>
    <RootNamespace>DotnetFastFormat.Cli</RootNamespace>
    <!-- A formatting run lasts seconds, so profile-guided instrumentation costs more than the code it improves (about 30 percent on the corpus). -->
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <!-- Start counting calls for tier-1 compilation at once instead of after 100 ms of quiet: a run formats thousands of files in a few seconds, so the delay keeps the hot code unoptimized (about 25 percent on the corpus). -->
    <RuntimeHostConfigurationOption Include="System.Runtime.TieredCompilation.CallCountingDelayMs" Value="0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="DotnetFastFormat.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../DotnetFastFormat.Core/DotnetFastFormat.Core.csproj" />
  </ItemGroup>
</Project>
